# Copy this file to .env and fill in the values.

# Supabase Postgres connection string — use the Session Pooler URL from
# Supabase Dashboard → Connect (the direct db.* host is IPv6-only).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# Secret used to sign organiser JWT tokens (any long random string)
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
FRONTEND_URL="http://localhost:3000"
