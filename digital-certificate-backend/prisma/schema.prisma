// Prisma schema for the digital certificate platform.
// Datasource URL is provided via prisma.config.ts (DATABASE_URL in .env).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  certificates Certificate[]
}

enum CertificateStatus {
  VALID
  REVOKED
}

model Certificate {
  id             String            @id @default(cuid())
  certId         String            @unique
  studentName    String
  studentEmail   String?
  courseName     String
  description    String?
  issueDate      DateTime          @default(now())
  expiryDate     DateTime?
  status         CertificateStatus @default(VALID)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}
